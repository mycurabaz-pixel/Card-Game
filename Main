    master_deck.shuffle();

    for (int i = 0; i < 30; ++i) {
        if (!master_deck.isEmpty()) {
            player1.addCardToPlayerDeck(master_deck.getTopCard());
            master_deck.removeTopCard();
        }
        if (!master_deck.isEmpty()) {
            player2.addCardToPlayerDeck(master_deck.getTopCard());
            master_deck.removeTopCard();
        }
    }

    player1.shuffleDeck();
    player2.shuffleDeck();
   
    std::cout << "--- Desteler Hazirlandi ve Karistirildi (Her oyuncuda 30 kart var) ---\n" << std::endl;
}

    void playTurn(){
        std::cout << "--------------------------\n" << std::endl;
        std::cout<<"--- Card Drawing Phase ---"<<std::endl;

        player1.drawCard();
        player2.drawCard();

        card* p1_card = player1.selectCard();
        if(p1_card != nullptr){
            std::cout<<player1.getName()<<"is playing..."<<std::endl;
            player1.playCard(p1_card, player2, battle_field);
            battle_field.addCardToDeck(p1_card);
        }

        card* p2_card = player2.selectCard();
        if(p2_card != nullptr){
            std::cout<<"\n"<<player2.getName()<<" is playing..."<<std::endl;
            player2.playCard(p2_card, player1, battle_field);
            battle_field.addCardToDeck(p2_card);
        }

    }

};

int main() {

    gameManager::getInstance().setPlayers("Geralt", "Yennefer");

    gameManager::getInstance().startGame();

    gameManager::getInstance().playTurn();

    return 0;
};
