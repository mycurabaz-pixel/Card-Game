class Player;
template <typename T> class Deck;


//========
//INTERFACE
//========


class IDamageable {
public:
    virtual void takeDamage(int dmg) = 0;
    virtual std::string getName() = 0;
    virtual int getHealth() = 0;
    virtual ~IDamageable() = default;   
};

template <typename T>
class Deck{

    private:

    std::vector<T> active_deck;
    std::vector<T> deck;

    public:

    void addCardToDeck(T item){
        deck.push_back(item);
    }

    void removeCardFromDeck(T target_card){
        for(auto it= deck.begin(); it != deck.end(); ++it){
            if((*it)->getPrivateCardId() == target_card->getPrivateCardId()){
                deck.erase(it);
                break;
            }
        }
    }

    void shuffle(){
        active_deck = deck;

        std::random_device rd;
        std::mt19937 gen(rd());
        std::shuffle(active_deck.begin(), active_deck.end(), gen);
    }

    T getTopCard(){
        if(!active_deck.empty()){
        return active_deck.back();
        }
        return nullptr;
    }

    void removeTopCard(){
        if(!active_deck.empty()){
            active_deck.pop_back();
        }
    }

    bool isEmpty(){
        return active_deck.empty();
    }

    const std::vector<T>& getCards() const {
    return deck;
}

};

class card : public IDamageable{

    public: 

    enum DmgType{
        ICE,
        FIRE,
        NATURE,
        WIND,
        MAGIC,
        ANTIMAGIC,
        DARKNESS,
        LIGHT,
        SLICE,
        NORMAL
    };

    private: 

    int health;
    inline static int id_counter = 1;
    int private_card_id;
    int private_deck_id;
    int range;
    DmgType dmgType;
    int type;
    std::string cardName;
    int cost;
    int dmgHit;

    public:

    card(int range, DmgType dmgType, int type, std::string cardName, int cost, int dmgHit, int health){
        this->range = range;
        this->dmgType = dmgType;
        this->type = type;
        this->cardName = cardName;
        this->cost = cost;
        this->dmgHit=dmgHit;
        private_card_id = id_counter;
        id_counter++;
        this->health = health;
    }

    int getDamageType(){
        return dmgType;
    }

    int getPrivateCardId(){
        return private_card_id;
    }

    int getType(){
        return type;
    }

    int getCost(){
        return cost;
    }
         
    void updateDmgHit(int dmgHit){
        this->dmgHit = dmgHit;
    }

    int getDmgHit(){
        return dmgHit;
    }

    void takeDamage(int dmg) override {
        health -= dmg;
    }

    int getHealth(){
        return health;
    }

    std::string getName() override {
        return cardName;
    }

    virtual ~card(){
        std::cout<<"card has been killed"<<std::endl;
    }

    virtual void hit(IDamageable* target) = 0;

    virtual void useUniquePower(Player& enemyplayer, Deck<card*>& battlefield, card* targetCard) = 0;

    virtual void activateTypeBuff() = 0;

};

class fantasyCard : public card {

    public:

    enum FantasyType{
        DRAGON,
        SOLDIER,
        MAGICIAN,
        HEALER
    };

    using AbilityFunction = std::function<void(Player& enemyPlayer, Deck<card*>& battlefield, card* targetCard)>;

    private:

    std::string unique_ability;
    int unique_ability_effect_power;
    FantasyType fType;
    int unique_dmg_buff=0;
    AbilityFunction uniquePower;

     public:

    fantasyCard(int range, DmgType dmgType, FantasyType type, std::string cardName, int cost, int dmgHit, std::string unique_ability, int unique_ability_effect_power, int health, AbilityFunction  power)
    : card(range, dmgType, type, cardName, cost, dmgHit, health){

        this->unique_ability = unique_ability;
        this->unique_ability_effect_power = unique_ability_effect_power;
        this->fType = type;
        this->uniquePower = power;
    }

    void random_unique_dmg(){
         std::random_device rd;

         std::mt19937 gen(rd());

         std::uniform_int_distribution<> interval_1(0, (card::getCost() * 2));

         unique_dmg_buff = interval_1(gen);

         card::updateDmgHit(card::getDmgHit() + unique_dmg_buff);
    }

    void hit(IDamageable* target) override {
        random_unique_dmg();
    
    target->takeDamage(card::getDmgHit()); 

    std::cout << card::getName() << ", " << target->getName() << " hedefine " << card::getDmgHit() << " vurdu!" << std::endl;

    if(unique_dmg_buff > card::getCost()/2){
        std::cout << "ENEMY HAS BEEN CURSED" << std::endl;

            switch(card::getDamageType()){

                case ICE:

                std::cout<<"düşman donduruldu"<<std::endl;
                break;

                case FIRE:

                std::cout<<"düşman yakıldı"<<std::endl;
               target->takeDamage(2);
                break;

                case NATURE:

                std::cout<<"ENEMY HAS BEEN ROOTED"<<std::endl;
                break;

                case WIND:

                std::cout<<"ENEMY HAS BEEN SLICED WİTH WİND"<<std::endl;
                 target->takeDamage(card::getDmgHit());

                break;

                case MAGIC:

                std::cout<<"YOU HİT EXTRA MAGIC DAMAGE AND GAINED 2 MANA"<<std::endl;
                target->takeDamage(card::getDmgHit());
                break;

                case ANTIMAGIC:

                std::cout<<"YOU HİT EXTRA ANTIMAGIC DAMAGE AND WASTED ENEMY'S 2 MANA"<<std::endl;
                 target->takeDamage(card::getDmgHit());
                break;

                case DARKNESS:

                std::cout<<"ENEMY BECAME FEARED"<<std::endl;
                break;

                case LIGHT:

                std::cout<<"ENEMY BECAME BLİND"<<std::endl;
                break;

                case SLICE:

                std::cout<<"ENEMY STARTED BLEEDİNG "<<std::endl;
                 target->takeDamage(2);
                break;

                case NORMAL:

                break;
            }
        }
        card::updateDmgHit(card::getDmgHit() - unique_dmg_buff);
    }

    void useUniquePower(Player& enemyPlayer, Deck<card*>& battlefield, card* targetCard) override {
       if(uniquePower){
        uniquePower(enemyPlayer, battlefield);
       }
    }

    void activateTypeBuff() override {
        std::cout<<"healing every fantasy card on the table and giving extra "<<card::getCost()<<"damage"<<std::endl;
    }

};


class TechCard : public card{

    public:

    enum TechnoType{
        ROBOT,
        MECHANIC,
        SOLDIER,
        TITAN
    };

    using AbilityFunction = std::function<void(Player& enemyPlayer, Deck<card*>& battlefield, card* targetCard)>;

    private:

    std::string unique_ability;
    int unique_ability_effect_power;
    TechnoType tType;
    int unique_dmg_buff=0;
    AbilityFunction uniquePower;

    public:

    TechCard(int range, DmgType dmgType, TechnoType type, std::string cardName, int cost, int dmgHit, std::string unique_ability, int unique_ability_effect_power, int health, AbilityFunction power)
        : card(range, dmgType, static_cast<int>(type), cardName, cost, dmgHit, health) {
        this->unique_ability = unique_ability;
        this->unique_ability_effect_power = unique_ability_effect_power;
        this->tType = type;
        this->uniquePower = power;
    }

    void random_unique_dmg(){
         std::random_device rd;

         std::mt19937 gen(rd());

         std::uniform_int_distribution<> interval_1(0, (card::getCost() * 2));

         unique_dmg_buff = interval_1(gen);

         card::updateDmgHit(card::getDmgHit() + unique_dmg_buff);
    }

    void hit(IDamageable* target) override {
        random_unique_dmg();
    
    target->takeDamage(card::getDmgHit());  

    if(unique_dmg_buff > card::getCost()/2){
        std::cout << "ENEMY HAS BEEN CURSED" << std::endl;

            switch(card::getDamageType()){

                case ICE:

                std::cout<<"düşman donduruldu"<<std::endl;
                break;

                case FIRE:

                std::cout<<"düşman yakıldı"<<std::endl;
               target->takeDamage(2);
                break;

                case NATURE:

                std::cout<<"ENEMY HAS BEEN ROOTED"<<std::endl;
                break;

                case WIND:

                std::cout<<"ENEMY HAS BEEN SLICED WİTH WİND"<<std::endl;
                 target->takeDamage(card::getDmgHit());

                break;

                case MAGIC:

                std::cout<<"YOU HİT EXTRA MAGIC DAMAGE AND GAINED 2 MANA"<<std::endl;
                target->takeDamage(card::getDmgHit());
                break;

                case ANTIMAGIC:

                std::cout<<"YOU HİT EXTRA ANTIMAGIC DAMAGE AND WASTED ENEMY'S 2 MANA"<<std::endl;
                 target->takeDamage(card::getDmgHit());
                break;

                case DARKNESS:

                std::cout<<"ENEMY BECAME FEARED"<<std::endl;
                break;

                case LIGHT:

                std::cout<<"ENEMY BECAME BLİND"<<std::endl;
                break;

                case SLICE:

                std::cout<<"ENEMY STARTED BLEEDİNG "<<std::endl;
                 target->takeDamage(2);
                break;

                case NORMAL:

                break;
            }
        }
        card::updateDmgHit(card::getDmgHit() - unique_dmg_buff);
    }

    void useUniquePower(Player& enemyPlayer, Deck<card*>& battlefield, card* targetCard) override {
       if(uniquePower){
        uniquePower(enemyPlayer, battlefield);
       }
    }

    void activateTypeBuff() override{
        cout<<"Every tech card on the table gets high voltage extra "<<card::getCost()/2<<"extra electrical damage"<<endl;
    }
};

