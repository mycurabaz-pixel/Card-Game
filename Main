class Player : public IDamageable {

    private:

    std::string player_name;
    int health = 1000;
    inline static int playerId = 1;
    Deck<card*> yourDeck;
    std::vector<card*> hand;
    Deck<card*> team;

    public:

    Player(std::string name) : player_name(name) {}

    int getHealth() override{
        return health;
    }

    void setHealth(int health){
        this->health = health;
    }

    std::string getName() override {
        return player_name;
    }

    void addCardToPlayerDeck(card* c){
        yourDeck.addCardToDeck(c);
    }

    void takeDamage(int dmg) override {
        health -= dmg;
    }

    void drawCard(){
        if(!yourDeck.isEmpty()){
            card* drawnCard = yourDeck.getTopCard();

            hand.push_back(drawnCard);

            yourDeck.removeTopCard();

            std::cout<<player_name<<"has drawn a card."<<std::endl;
        }
        else{
            std::cout<<"Deck is empty, cant drawn a card!"<<std::endl;
        }
    }

    void playCard(card* played_card, IDamageable* target, Deck<card*>& battlefield, Player& enemyPlayer){
    for(auto it = hand.begin(); it != hand.end(); ++it){
        if((*it)->getPrivateCardId() == played_card->getPrivateCardId()){
            
           this->attackTarget(played_card, target, battlefield, enemyPlayer, played_card, this->team);  
            
           battlefield.addCardToDeck(played_card);
           team.addCardToDeck(played_card);
            hand.erase(it);
            break;
        }
    }
}

    void shuffleDeck(){
        yourDeck.shuffle();
    }

    card* selectCard(){
        int i = 0;
        int selection;
        for(card* c: hand){
            std::cout<<i++<<".card "<<c->getName()<<std::endl;
        }
        std::cout<<"seçiminiz:"<<std::endl;
        std::cin>>selection;
        return hand.at(selection);
    }

    // Bir kartın başka bir karta saldırmasını ve ölüm kontrolünü yöneten fonksiyon
    void attackTarget(card* attacker, IDamageable* target, Deck<card*>& battlefield, Player& enemyPlayer, card* self, Deck<card*> allyTeam) {

        attacker->hit(target);

       attacker->useUniquePower(target, battlefield, self, allyTeam, enemyPlayer.getTeam());

        //Death control
        if (target->getHealth() <= 0) {
            std::cout << target->getName() << "died!" << std::endl;

            //By using C++ RTTI (RunTime Type Information) to understand if the target is card or player and only if it's a card we erase from battlefield
            card* deadCard = dynamic_cast<card*>(target);
            if(deadCard != nullptr){
            battlefield.removeCardFromDeck(deadCard);
            }
            else{
                std::cout<<"GAME OVER!!! " <<target->getName()<<" has been defeated."<<std::endl;
            }
        }
    }

    void addToTeam(card* c) { team.addCardToDeck(c); }
    Deck<card*>& getTeam() { return team; }

};

class gameManager{
    Deck<card*> master_deck;
    Deck<card*> battle_field;
    Player player1{"player1"};
    Player player2{"player2"};
    int turn_counter = 0;

    private:
     gameManager(){}

    public:

    static gameManager& getInstance() { static gameManager instance; return instance; }

    gameManager(const gameManager&) = delete;
    gameManager& operator=(const gameManager) = delete;

    void setPlayers(std::string player1_name, std::string player2_name){
        player1 = Player(player1_name);
         player2 = Player(player2_name);
    }

void startGame() {
    // ==========================================
    // 20 FANTASY CARDS (With Lambda Abilities)
    // ==========================================
    master_deck.addCardToDeck(new fantasyCard(
    1, card::DmgType::FIRE, fantasyCard::FantasyType::DRAGON, "Flame Dragon", 7, 45, "Breath", 20, 300, 
    [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) {
        std::cout << "-> Ability: Set the battlefield on fire!" << std::endl;
        for(card* c: pitch.getCards()) {
            c->takeDamage(5);
        }
    }
));
 
    master_deck.addCardToDeck(new fantasyCard(
        1, card::DmgType::FIRE, fantasyCard::FantasyType::DRAGON, "Red Dragon", 6, 40, "Ember", 18, 400, 
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Shot a critical ember!" << std::endl; 
            if(target != nullptr){
