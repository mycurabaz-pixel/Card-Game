    std::cout << "Damage Output  : " << getDmgHit() << " (+ Buff: " << unique_dmg_buff << ")" << std::endl;
    
    std::cout << "Damage Type    : ";
    switch(getDamageType()) {
        case ICE: std::cout << "Ice"; break;
        case FIRE: std::cout << "Fire"; break;
        case NATURE: std::cout << "Nature"; break;
        case WIND: std::cout << "Wind"; break;
        case MAGIC: std::cout << "Magic"; break;
        case ANTIMAGIC: std::cout << "Anti-Magic"; break;
        case DARKNESS: std::cout << "Darkness"; break;
        case LIGHT: std::cout << "Light"; break;
        case SLICE: std::cout << "Slice"; break;
        case NORMAL: std::cout << "Normal"; break;
        default: std::cout << "Unknown"; break;
    }
    std::cout << std::endl;

    std::cout << "Model Type     : ";
    switch(tType) {
        case ROBOT: std::cout << "Robot"; break;
        case MECHANIC: std::cout << "Mechanic"; break;
        case SOLDIER: std::cout << "Cyber Soldier"; break;
        case TITAN: std::cout << "Titan"; break;
    }
    std::cout << std::endl;

    std::cout << "Hardware       : " << unique_ability << " (Effect Power: " << unique_ability_effect_power << ")" << std::endl;
    std::cout << "======================================\n" << std::endl;
}

