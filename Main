        1, card::DmgType::NORMAL, SeaSonCard::SeaSonType::PIRATE, "Ship Crew", 1, 12, "Drunken sailor", 4, 25,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Threw a rum bottle!" << std::endl; 
            target->takeDamage(10);
        }
    ));
 
    master_deck.addCardToDeck(new SeaSonCard(
        2, card::DmgType::ANTIMAGIC, SeaSonCard::SeaSonType::ORACLE, "Deepwater Guardian", 6, 26, "Deluge", 18, 90,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Will drown the magic shield in a vortex!" << std::endl; 
        }
    ));
 
    master_deck.addCardToDeck(new SeaSonCard(
        1, card::DmgType::SLICE, SeaSonCard::SeaSonType::KRAKEN, "Razor Tentacle", 6, 40, "Eight Slash", 20, 350,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Sharp tentacle slash!" << std::endl; 
            for(card* c: enemyTeam.getCards()){
                c->takeDamage(20);
            }
        }
    ));
 
    master_deck.addCardToDeck(new SeaSonCard(
        2, card::DmgType::ICE, SeaSonCard::SeaSonType::MEDIC, "Glacial Savior", 4, 12, "Healing Wave", 14, 55,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Performed cold water shock therapy!" << std::endl; 
            for(card* c: allyTeam.getCards()){
                c->takeDamage(-10);
            }
        }
    ));
 
    master_deck.addCardToDeck(new SeaSonCard(
        3, card::DmgType::DARKNESS, SeaSonCard::SeaSonType::ORACLE, "Abyss Witch", 5, 22, "Darkness of the deep sea", 26, 60,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Mariana trench darkness!" << std::endl; 
            target->takeDamage(35);
        }
    ));
 
    master_deck.addCardToDeck(new SeaSonCard(
        1, card::DmgType::FIRE, SeaSonCard::SeaSonType::PIRATE, "Lava Captain", 5, 36, "Lava shot", 16, 75,
        [](IDamageable* target, Deck<card*>& pitch, card* self, Deck<card*>& allyTeam, Deck<card*>& enemyTeam) { 
            std::cout << "-> Ability: Volcanic pirate attack!" << std::endl; 
